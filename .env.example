# Copy to .env and fill in. .env is gitignored; never commit real values.

# Nebius Token Factory API key (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# WSL path to your Obsidian vault, e.g. /mnt/c/Users/<you>/<vault>
EL_VAULT=

# NemoClaw sandbox that runs Hermes (optional, defaults to e-l)
EL_SANDBOX=

# Seconds between checks that Hermes's copy of the vault is current (optional,
# defaults to 120; 0 turns syncing off, e.g. for the hosted demo)
EL_SYNC_INTERVAL=
